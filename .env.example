APP_NAME="HAKO-RA Campus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
# Fuseau IANA d’affichage ; les instants serveur restent en UTC.
APP_TIMEZONE=Africa/Abidjan

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hako_ra_campus_dev
DB_USERNAME=hako_campus_local
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# En local aucun courriel ni contenu de message n’est envoyé aux logs.
MAIL_MAILER=array

# Connexion par compte Google (facultative). Créer un identifiant OAuth « application Web » dans la console Google Cloud,
# avec l'adresse de retour <APP_URL>/connexion/google/reponse. Laisser vide pour désactiver.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"

# Identité (lot 04). Valeurs proposées, à valider.
CAMPUS_REGISTRATION_ENABLED=true
CAMPUS_ACTIVATION_TTL_HOURS=72
# Les rôles privilégiés exigent un second facteur activé par chaque compte. Cette dérogation ne vaut qu'en local et en test.
# Dérogation réservée au local/test sur données fictives, sans effet en production.
CAMPUS_PRIVILEGED_WITHOUT_MFA=false
# Parcours des mineurs : fermé tant que les deux valeurs ne sont pas renseignées (arbitrage A06).
CAMPUS_MINORS_ENABLED=false
CAMPUS_MINORS_FRAMEWORK_REFERENCE=
CAMPUS_INVITATION_TTL_DAYS=14
CAMPUS_PUBLICATION_MAX_OCCURRENCES=20000
CAMPUS_IMPORT_MAX_KB=5120
CAMPUS_IMPORT_MAX_ROWS=5000
CAMPUS_IMPORT_RAW_RETENTION_DAYS=30
CAMPUS_CHECK_IN_PENDING_DAYS=7

CAMPUS_TASK_TRASH_DAYS=7
CAMPUS_GRADE_WATCH_THRESHOLD=10
# Rappels : canaux externes désactivés tant qu ils ne sont pas configurés ; le centre interne fonctionne toujours.
CAMPUS_NOTIFICATION_EMAIL_ENABLED=false
CAMPUS_PUSH_PRIVATE_KEY=
CAMPUS_PUSH_SUBJECT=
# Pièces jointes : sans antivirus configuré (none), aucun fichier déposé ne peut être téléchargé.
CAMPUS_ATTACHMENT_MAX_KB=5120
CAMPUS_ATTACHMENT_MAX_PER_OBJECT=3
CAMPUS_ATTACHMENT_USER_QUOTA_MB=100
CAMPUS_ATTACHMENT_SCANNER=none
CAMPUS_CLAMD_HOST=127.0.0.1
CAMPUS_CLAMD_PORT=3310

CAMPUS_OPPORTUNITY_CLOSING_SOON_DAYS=7
CAMPUS_OFFLINE_TTL_DAYS=7
CAMPUS_SYNC_RETENTION_DAYS=90
CAMPUS_SUPPORT_EMAIL=
# Confidentialité : à compléter avant toute ouverture (la notice les affiche « à compléter » tant qu'ils sont vides).
CAMPUS_PRIVACY_CONTROLLER=
CAMPUS_PRIVACY_CONTACT=
CAMPUS_HOSTING_REGION=
CAMPUS_EXPORT_TTL_DAYS=7
# Journal des effacements : à placer sur un stockage distinct de la base, sauvegardé séparément.
CAMPUS_ERASURE_JOURNAL_PATH=
CAMPUS_ERASURE_JOURNAL_RETENTION_DAYS=180
CAMPUS_RETENTION_INVITATION_DAYS=30
CAMPUS_RETENTION_NOTIFICATION_DAYS=90
CAMPUS_RETENTION_AUDIT_MONTHS=12
CAMPUS_RETENTION_INACTIVITY_MONTHS=24
CAMPUS_RETENTION_BACKUP_DAYS=30
# Sauvegardes : dossier hors de l'instance principale ; clé générée par « php artisan campus:backup key --output=... », conservée à part.
CAMPUS_BACKUP_DIRECTORY=
CAMPUS_BACKUP_KEY=
CAMPUS_MYSQLDUMP_PATH=mysqldump
CAMPUS_MYSQL_PATH=mysql
# Supervision : jeton d'au moins 32 caractères pour la sonde externe (point /sante), contact d'alerte à renseigner.
CAMPUS_MONITORING_TOKEN=
CAMPUS_ALERT_CONTACT=
CAMPUS_MAIL_DAILY_LIMIT=
